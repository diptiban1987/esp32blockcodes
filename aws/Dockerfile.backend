# aws/Dockerfile.backend — Backend container for Arduino compile/upload API
# Run:
#   docker build -f aws/Dockerfile.backend -t techyguide-backend .
#   docker run -p 3000:3000 --env-file aws/backend.env techyguide-backend
#
# Note: compileServer.js was originally developed on Windows. This Dockerfile
# uses Linux paths and environment variables so it runs on AWS ECS / EKS / EC2.

FROM node:18-slim

# Install tools required by arduino-cli and the ESP32 core toolchain
RUN apt-get update && apt-get install -y \
    curl ca-certificates python3 python3-pip python3-serial git unzip \
    && rm -rf /var/lib/apt/lists/*

# Install arduino-cli and place it on PATH
RUN curl -fsSL https://raw.githubusercontent.com/arduino/arduino-cli/master/install.sh | sh \
    && mv bin/arduino-cli /usr/local/bin/arduino-cli \
    && arduino-cli version

# Directories for board packages and libraries
RUN mkdir -p /arduino-data /arduino-libraries
ENV ARDUINO_DATA_DIR=/arduino-data
ENV ARDUINO_LIBRARIES_DIR=/arduino-libraries

# Add ESP32 package index and install ESP32 and Raspberry Pi Pico cores
RUN arduino-cli config init --overwrite \
    && arduino-cli config add board_manager.additional_urls "https://espressif.github.io/arduino-esp32/package_esp32_index.json" \
    && arduino-cli core update-index \
    && arduino-cli core install esp32:esp32 \
    && arduino-cli core install arduino:mbed_rp2040

WORKDIR /app

# Install Node dependencies
COPY package*.json ./
RUN npm install

# Copy application source
COPY . .

EXPOSE 3000

CMD ["npm", "run", "server"]
